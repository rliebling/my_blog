{{- /* Keep meta/og descriptions in LinkedIn's useful range (~100-160 chars). */ -}}
{{- $max := 160 -}}
{{- with .Description -}}
  {{- . | plainify | htmlUnescape | truncate $max -}}
{{- else -}}
  {{- if .IsPage -}}
    {{- .Summary | plainify | htmlUnescape | truncate $max -}}
  {{- else -}}
    {{- with .Site.Params.info.metaDescription -}}
      {{- . | plainify | htmlUnescape | truncate $max -}}
    {{- else -}}
      {{- with .Site.Params.info.description -}}
        {{- . -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
